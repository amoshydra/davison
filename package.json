{
  "name": "@amoshydra/davison",
  "version": "0.1.0",
  "description": "WebDAV music server + Sonos controller. npx @amoshydra/davison --path /music",
  "type": "module",
  "bin": {
    "davison": "./bin/davison.js"
  },
  "scripts": {
    "dev": "tsx watch --ignore './vite.config.ts.timestamp-*' --ignore ./src --ignore ./node_modules server/index.ts",
    "build:frontend": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:server && npm run build:frontend",
    "serve": "NODE_ENV=production node dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t davison .",
    "docker:run": "docker run --network host -v $(pwd)/music:/music:ro davison --path /music",
    "postinstall": "node scripts/patch-nephele.mjs",
    "predev": "node scripts/patch-nephele.mjs",
    "smoke": "node scripts/smoke.mjs",
    "lint:package": "publint",
    "prepack": "pnpm run build"
  },
  "files": [
    "dist/",
    "dist-server/",
    "bin/",
    "scripts/patch-nephele.mjs",
    "package.json",
    "README.md",
    "LICENSE",
    "vite.config.ts"
  ],
  "dependencies": {
    "commander": "^12.1.0",
    "express": "^4.22.3",
    "mime": "^4.1.0",
    "music-metadata": "^12.3.2",
    "nephele": "1.0.0-alpha.68",
    "sonos": "^1.14.3",
    "vite-express": "^0.22.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/mime": "^4.0.0",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "lucide-react": "^1.23.0",
    "publint": "^0.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amoshydra/davison.git"
  },
  "bugs": {
    "url": "https://github.com/amoshydra/davison/issues"
  },
  "homepage": "https://github.com/amoshydra/davison#readme",
  "license": "MIT",
  "author": "amoshydra",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.10.0",
  "keywords": [
    "sonos",
    "webdav",
    "music",
    "music-server",
    "local-network",
    "streaming",
    "npx"
  ]
}
